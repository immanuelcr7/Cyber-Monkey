# Database Configuration
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/cyber_monkey

# Security Settings
# Generate a secure key using: openssl rand -hex 32
SECRET_KEY=replace_with_a_very_secret_key_for_jwt_and_sessions

# CORS Settings
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# DNS Resolver Configuration (leave empty to use system default)
# DNS_RESOLVER=8.8.8.8,8.8.4.4
# DNS_TIMEOUT=2.0

# theHarvester Configuration (Path to theHarvester folder, execution timeout in seconds, and comma-separated sources)
THEHARVESTER_PATH=C:\Tools\theHarvester
THEHARVESTER_TIMEOUT=300
THEHARVESTER_SOURCES=crtsh,certspotter


